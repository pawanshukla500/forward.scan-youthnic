<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_launcher_foreground"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="UI State Preview (Debug Only)"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- State Buttons (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateIdle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="Idle"
                android:textSize="12sp"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateOk"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="OK (Green)"
                android:textColor="@color/verdict_ok"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/verdict_ok" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateCheck"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="Check (Amber)"
                android:textColor="@color/verdict_check"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/verdict_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateStop"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="Stop (Red)"
                android:textColor="@color/verdict_stop"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/verdict_stop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateDuplicate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="Duplicate"
                android:textColor="@color/verdict_duplicate"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/verdict_duplicate" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateOffline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Offline Error"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:cornerRadius="6dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Simulated Preview Container -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <include
            android:id="@+id/previewScannerLayout"
            layout="@layout/activity_scanner" />

    </FrameLayout>

</LinearLayout>
