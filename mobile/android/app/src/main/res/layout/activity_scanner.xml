<?xml version="1.0" encoding="utf-8"?>
<!-- Continuous scanner: header (channel, connection, today's progress) | always-open camera | last result |
     action bar (Torch, Manual, Pending, Recent). The full-screen result flash is added on top by ScannerActivity.
     Ids are shared with PreviewActivity (debug UI preview). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="3dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/change_marketplace"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <View
                android:id="@+id/viewChannelColor"
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_marker"
                android:backgroundTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvScannerChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Tulip Prints - Meesho" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/verdict_ok_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/connection_online"
                android:textColor="@color/verdict_ok"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProgressScanned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="4 scanned today" />

            <TextView
                android:id="@+id/tvProgressPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/verdict_check"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="186 pending" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarScans"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/progress_track"
            android:progressTint="@color/colorPrimary" />
    </LinearLayout>

    <!-- App update available: never covers the camera, tap to install -->
    <TextView
        android:id="@+id/tvUpdateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/text_on_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Update 1.0.21 available - tap to install"
        tools:visibility="visible" />

    <!-- Camera: always open; height is set to ~1/3 of the screen in ScannerActivity -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#000000">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/viewFinder"
            android:layout_width="260dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/viewfinder_border" />

        <TextView
            android:id="@+id/tvScannerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#99000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/aim_at_awb"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressSubmitting"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/viewfinder_reticle"
            android:visibility="gone" />

        <!-- Result stamp: pops up over the camera for a moment after every scan (OK / DUPLICATE / NOT FOUND ...) -->
        <LinearLayout
            android:id="@+id/layoutSignalStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_round_card"
            android:backgroundTint="@color/verdict_ok"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivSignalStamp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_signal_ok" />

            <TextView
                android:id="@+id/tvSignalStamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:accessibilityLiveRegion="assertive"
                android:maxLines="1"
                android:textColor="@color/text_on_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="DUPLICATE" />
        </LinearLayout>
    </FrameLayout>

    <!-- Result Area -->
    <ScrollView
        android:id="@+id/scrollResultArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Results since the scanner was opened: the matching number goes up with every scan -->
            <HorizontalScrollView
                android:id="@+id/scrollTally"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/tally_label"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTallyOk"
                        style="@style/TallyPill"
                        android:backgroundTint="@color/verdict_ok_bg"
                        android:textColor="@color/verdict_ok"
                        tools:text="OK 12" />

                    <TextView
                        android:id="@+id/tvTallyDuplicate"
                        style="@style/TallyPill"
                        android:backgroundTint="@color/verdict_duplicate_bg"
                        android:textColor="@color/verdict_duplicate"
                        tools:text="Duplicate 1" />

                    <TextView
                        android:id="@+id/tvTallyNotFound"
                        style="@style/TallyPill"
                        android:backgroundTint="@color/verdict_unverified_bg"
                        android:textColor="@color/verdict_unverified"
                        tools:text="Not found 0" />

                    <TextView
                        android:id="@+id/tvTallyCheck"
                        style="@style/TallyPill"
                        android:backgroundTint="@color/verdict_check_bg"
                        android:textColor="@color/verdict_check"
                        android:visibility="gone"
                        tools:text="Check 1"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvTallyStop"
                        style="@style/TallyPill"
                        android:backgroundTint="@color/verdict_stop_bg"
                        android:textColor="@color/verdict_stop"
                        android:visibility="gone"
                        tools:text="Stop 2"
                        tools:visibility="visible" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="2dp"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/layoutResultContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/bannerVerdict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/verdict_ok"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivVerdictIcon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="8dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_signal_ok" />

                            <TextView
                                android:id="@+id/tvVerdictTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/verdict_verified"
                                android:textColor="@color/text_on_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- "#12 · 10:42:05": tells one OK apart from the next -->
                            <TextView
                                android:id="@+id/tvScanSeq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:alpha="0.9"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_on_primary"
                                android:textSize="12sp"
                                tools:text="#12 · 10:42:05" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvVerdictMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_on_primary"
                            android:textSize="13sp"
                            tools:text="Verified - place in dispatch bag" />

                        <!-- What to do with the packet now -->
                        <TextView
                            android:id="@+id/tvVerdictAction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_on_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="Put it in the bag"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutShipmentDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_awb"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResultAwb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_primary"
                            android:textIsSelectable="true"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            tools:text="FMPC1234567890" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="@color/border" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_order_id"
                                    android:textColor="@color/text_muted"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvResultOrderId"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="middle"
                                    android:maxLines="1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="OD-12345" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_courier"
                                    android:textColor="@color/text_muted"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvResultCourier"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="Delhivery" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_items"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResultItemsCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="1 SKU · 1 unit" />

                        <LinearLayout
                            android:id="@+id/layoutItemsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Before the first scan -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIdleState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ready_to_scan"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/ready_to_scan_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- What each result looks, sounds and feels like; tap a row to try it -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="2dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/legend_title"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <include
                        android:id="@+id/legendOk"
                        layout="@layout/item_signal_row" />

                    <include
                        android:id="@+id/legendDuplicate"
                        layout="@layout/item_signal_row" />

                    <include
                        android:id="@+id/legendNotFound"
                        layout="@layout/item_signal_row" />

                    <include
                        android:id="@+id/legendCheck"
                        layout="@layout/item_signal_row" />

                    <include
                        android:id="@+id/legendStop"
                        layout="@layout/item_signal_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Action bar: icon + label buttons, 64dp tall (thumb-friendly) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/btnTorch"
            style="@style/ScannerAction">

            <ImageView
                android:id="@+id/ivTorch"
                style="@style/ScannerActionIcon"
                android:src="@drawable/ic_torch" />

            <TextView
                android:id="@+id/tvTorchLabel"
                style="@style/ScannerActionLabel"
                android:text="@string/torch_off" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnManual"
            style="@style/ScannerAction">

            <ImageView
                style="@style/ScannerActionIcon"
                android:src="@drawable/ic_keyboard" />

            <TextView
                style="@style/ScannerActionLabel"
                android:text="@string/manual_entry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPending"
            style="@style/ScannerAction">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="24dp">

                <ImageView
                    style="@style/ScannerActionIcon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pending" />

                <TextView
                    android:id="@+id/tvPendingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/verdict_check"
                    android:gravity="center"
                    android:minWidth="16dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/text_on_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="186"
                    tools:visibility="visible" />
            </FrameLayout>

            <TextView
                style="@style/ScannerActionLabel"
                android:text="@string/pending_label_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnRecent"
            style="@style/ScannerAction">

            <ImageView
                style="@style/ScannerActionIcon"
                android:src="@drawable/ic_history" />

            <TextView
                style="@style/ScannerActionLabel"
                android:text="@string/recent_short" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
