<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the Pending / Recent scans sheets: AWB + tag pill, then two lines of detail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRowAwb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="SF1234567890MSH" />

        <TextView
            android:id="@+id/tvRowTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/verdict_stop_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/verdict_stop"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Urgent" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Order 1234567 · Delhivery · 2 SKUs, 3 units" />

    <TextView
        android:id="@+id/tvRowWhen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="AWB from 6 Oct · 1 day late" />
</LinearLayout>
