# OMSGuru (Profile page -> API token / client id)
OMSGURU_API_TOKEN=
OMSGURU_CLIENT_ID=
OMSGURU_USE_MOCK=false

# Seconds between incremental invoice syncs (each run costs >= 1 of the 60 credits / 5 min)
SYNC_INTERVAL_SECONDS=60
# Page size for OMSGuru list calls (max 100 - higher = fewer API calls)
BATCH_LIMIT=100
DATABASE_URL=sqlite:///omsguru_forward_scan.db
# For Postgres: DATABASE_URL=postgresql://user:pass@host:5432/dbname  (pip install psycopg[binary])

# --- Forward Scan app ---
APP_SECRET_KEY=change-me-to-a-long-random-string
# Default admin: created at startup when no account has ADMIN_EMAIL (never overwritten afterwards).
# Sign in with the email or the username; change the password in the app (user menu -> key icon).
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@yourcompany.com
ADMIN_USERNAME=your.name
# Quote it if it contains $ or #, e.g. ADMIN_PASSWORD='Pass$word1'
ADMIN_PASSWORD=change-me-8chars
OMSGURU_RESERVE_CREDITS=5
ORDER_LOOKBACK_DAYS=15
OPEN_ORDERS_REFRESH_MINUTES=30
CANCEL_SWEEP_MINUTES=20
TZ_OFFSET_MINUTES=330
DAY_START_HOUR=0
SESSION_HOURS=14
# Every scan fetches its order live from OMSGuru (order_details by sub-order id); falls back to the local copy if busy
LIVE_LOOKUP=true
LIVE_TIMEOUT_SECONDS=2.5
# API credits background sync leaves free so scan-time calls almost always get one
LIVE_HEADROOM=4
# Days of cancellations to check against the working set (cancelled-before-processing orders are ignored)
CANCEL_CHECK_DAYS=3
# Keep this many days of unscanned order data (by AWB generation date) for pending / duplicate / cancel checks.
# Orders still Packed / Ready-to-ship are always kept (they are pending).
RETAIN_ORDERS_DAYS=7
# Unscanned (not cancelled) AWBs stay pending until scanned, at most this many days
PENDING_KEEP_DAYS=45
# Scanned data (scans with their order details + the orders they belong to) is kept this many whole years from the
# scan date (0 = forever). Older data is removed once a month on RETENTION_DAY (1-28) from 03:00; every removed
# scan is written to backups/removed-scans/ (and the cloud backup) first.
SCAN_RETENTION_YEARS=2
RETENTION_DAY=10
# Fill the previous days' AWBs in the background using only spare API credits
HISTORY_BACKFILL=true

# --- Automatic backups (SQLite and PostgreSQL) ---
# Daily full backup (compressed, checked) + a copy of recent scans every BACKUP_RECENT_MINUTES.
BACKUP_ENABLED=true
# Default: backups\<database name> next to a SQLite database (e.g. backups\omsguru_forward_scan);
# PostgreSQL: data/backups/pg-<database name> (the folder the server keeps across deploys). Same disk either way!
BACKUP_DIR=
# IMPORTANT: a second place on ANOTHER physical disk - NAS share, USB disk or another PC, e.g. \NAS\fs-backups
BACKUP_MIRROR_DIR=
# Offsite copy with rclone (Google Drive, S3, ...). Empty = use the "gdrive" remote from data/rclone/rclone.conf
# when it exists (README "Backups & restore" -> Offsite copy). Daily backups are kept there BACKUP_OFFSITE_KEEP_DAYS.
BACKUP_OFFSITE_REMOTE=
BACKUP_OFFSITE_KEEP_DAYS=60
BACKUP_FULL_HOUR=2
BACKUP_RECENT_MINUTES=15
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=12

# --- Android app distribution ---
# Public address of this server: the download link and QR code in Admin use it (https://.../download).
PUBLIC_URL=
# Where the "Build Android APK" workflow drops forward-scan-app.apk + latest.json (default data/app).
APP_RELEASE_DIR=
