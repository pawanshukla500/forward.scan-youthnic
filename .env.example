# OMSGuru (Profile page -> API token / client id)
OMSGURU_API_TOKEN=
OMSGURU_CLIENT_ID=
OMSGURU_USE_MOCK=false

# Seconds between incremental invoice syncs (each run costs >= 1 of the 60 credits / 5 min)
SYNC_INTERVAL_SECONDS=60
# Page size for OMSGuru list calls (max 100 - higher = fewer API calls)
BATCH_LIMIT=100
DATABASE_URL=sqlite:///omsguru_forward_scan.db
# For Postgres: DATABASE_URL=postgresql://user:pass@host:5432/dbname  (pip install psycopg[binary])

# --- Forward Scan app ---
APP_SECRET_KEY=change-me-to-a-long-random-string
# Default admin: created at startup when no account has ADMIN_EMAIL (never overwritten afterwards).
# Sign in with the email or the username; change the password in the app (user menu -> key icon).
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@yourcompany.com
ADMIN_USERNAME=your.name
# Quote it if it contains $ or #, e.g. ADMIN_PASSWORD='Pass$word1'
ADMIN_PASSWORD=change-me-8chars
OMSGURU_RESERVE_CREDITS=5
ORDER_LOOKBACK_DAYS=15
OPEN_ORDERS_REFRESH_MINUTES=30
CANCEL_SWEEP_MINUTES=20
TZ_OFFSET_MINUTES=330
DAY_START_HOUR=0
SESSION_HOURS=14
# Every scan fetches its order live from OMSGuru (order_details by sub-order id); falls back to the local copy if busy
LIVE_LOOKUP=true
LIVE_TIMEOUT_SECONDS=2.5
# API credits background sync leaves free so scan-time calls almost always get one
LIVE_HEADROOM=4
# Days of cancellations to check against the working set (cancelled-before-processing orders are ignored)
CANCEL_CHECK_DAYS=3
# Keep this many days of order data (by AWB generation date) for pending / duplicate / cancel checks.
# Orders still Packed / Ready-to-ship are always kept (they are pending).
RETAIN_ORDERS_DAYS=7
# Scans are kept this many days from the scan date (0 = forever). 730 = 2 years, 1095 = 3 years.
SCAN_RETENTION_DAYS=1095
# Fill the previous days' AWBs in the background using only spare API credits
HISTORY_BACKFILL=true

# --- Automatic backups (SQLite) ---
# Daily full backup (compressed, checked) + a copy of recent scans every BACKUP_RECENT_MINUTES.
BACKUP_ENABLED=true
# Default: backups\<database name> next to the database, e.g. backups\omsguru_forward_scan (same disk!)
BACKUP_DIR=
# IMPORTANT: a second place on ANOTHER physical disk - NAS share, USB disk or another PC, e.g. \NAS\fs-backups
BACKUP_MIRROR_DIR=
BACKUP_FULL_HOUR=2
BACKUP_RECENT_MINUTES=15
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=12
# Scans under a year of retention need SCAN_RETENTION_FORCE=true (protects against a typo deleting history)
SCAN_RETENTION_FORCE=false
